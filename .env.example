# Скопируйте в .env и поправьте:   cp .env.example .env

# --- Сеть ---
# Внешний порт сервера. 3000 у вас занят, поэтому по умолчанию 8420.
# Проверить, свободен ли порт:  ss -ltn | grep ':8420'
HOST_PORT=8420
# 0.0.0.0 — доступен снаружи; 127.0.0.1 — только с самого сервера (когда перед приложением стоит nginx/Caddy)
BIND_ADDR=0.0.0.0

# --- HTTPS ---
# ВАЖНО: без HTTPS логины и пароли уходят по сети открытым текстом. Для реального использования включите HTTPS
# (профиль Caddy из docker-compose.yml или свой nginx — см. README.md).
# За обратным прокси:  TRUST_PROXY=1  и  COOKIE_SECURE=true
TRUST_PROXY=
COOKIE_SECURE=auto
# Домен для профиля https (Caddy получит сертификат сам):
DOMAIN=

# --- Регистрация ---
# open — любой может создать аккаунт; closed — регистрация закрыта (пользователей создаёт админ командой cli, см. README)
REGISTRATION=open
# Если задан — для регистрации нужен этот код приглашения (удобно, чтобы закрыть сервис от посторонних)
REGISTRATION_CODE=

# --- Лимиты ---
USER_QUOTA_MB=1024     # место под скриншоты на одного пользователя
MAX_IMAGE_MB=40        # максимальный размер одного файла
SESSION_DAYS=30        # сколько дней держится вход

# --- Резервные копии базы (внутри тома /data/backups) ---
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=7
